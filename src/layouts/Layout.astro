---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alur Antrean Rumah Sakit — Simulasi 3D',
  description = 'Panduan informatif alur antrean pelayanan rumah sakit dengan simulasi 3D isometrik: pendaftaran, skrining, poliklinik, hingga farmasi dan kasir.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <a
      href="#konten-utama"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-sky-600 focus:text-white focus:rounded-lg"
    >
      Lewati ke konten utama
    </a>
    <slot />
  </body>
</html>
