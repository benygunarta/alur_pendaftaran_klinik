---
import Layout from '../layouts/Layout.astro';
import QueueViewer from '../components/QueueViewer.astro';
import DocumentIllustration from '../components/DocumentIllustration.astro';
import { QUEUE_STEPS } from '../data/queueSteps';
import { QUEUE_DOCUMENTS } from '../content/documents';
import { SITE_INFO } from '../data/siteInfo';

const navLinks = [
  { href: '#simulasi', label: 'Simulasi 3D' },
  { href: '#alur', label: 'Tahapan' },
  { href: '#dokumen', label: 'Dokumen' },
];

---

<Layout>
  <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/85 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
      <a href="#" class="flex items-center gap-2.5">
        <span
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-600 text-lg font-black text-white"
          aria-hidden="true"
        >
          +
        </span>
        <span class="text-sm font-bold tracking-tight text-slate-900 sm:text-base">
          AntreanRS <span class="hidden font-normal text-slate-500 sm:inline">/ Panduan Layanan</span>
        </span>
      </a>

      <nav aria-label="Navigasi utama">
        <ul class="flex items-center gap-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <main class="min-h-screen bg-slate-50">
    <!-- Hero -->
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <div class="max-w-3xl">
          <span
            class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 ring-1 ring-emerald-600/20 ring-inset"
          >
            Panduan Pasien
          </span>
          <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Alur Antrean Pelayanan Rumah Sakit
          </h1>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Kenali empat tahap pelayanan — dari pendaftaran, skrining, poliklinik, hingga farmasi
            dan kasir — melalui simulasi 3D isometrik yang menampilkan pergerakan pasien dari satu
            ruangan ke ruangan berikutnya.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            <strong class="font-semibold">Tiba 30 menit lebih awal</strong>
            mempercepat proses pendaftaran dan mengurangi waktu antrean di loket.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="#simulasi"
              class="rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
            >
              Mulai Simulasi
            </a>
            <a
              href="#dokumen"
              class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
            >
              Siapkan KTP & BPJS
            </a>
          </div>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-slate-100 pt-8 sm:grid-cols-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Tahapan</dt>
            <dd class="mt-1 text-2xl font-bold text-slate-900">4 Ruangan</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Total waktu</dt>
            <dd class="mt-1 text-2xl font-bold text-slate-900">
              <span class="font-medium text-sky-600">Estimasi (ilustrasi)</span> ± 30–70 menit
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Dokumen utama</dt>
            <dd class="mt-1 text-2xl font-bold text-slate-900">KTP & BPJS</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Catatan</dt>
            <dd class="mt-1 text-2xl font-bold text-slate-900">
              <span class="font-medium text-sky-600">Ilustrasi</span>: simulasi bukan data real-time
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Simulasi 3D -->
    <QueueViewer />

    <!-- Tahapan layanan -->
    <section id="alur" class="scroll-mt-20 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Empat Tahap Pelayanan
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Setiap tahap memiliki ruangan, petugas, dan berkas yang berbeda. Urutan berikut adalah
            alur normal pasien umum tanpa rujukan khusus.
          </p>

          <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
            {
              QUEUE_STEPS.map((step) => (
                <li class="flex flex-col rounded-2xl border border-slate-200 bg-slate-50 p-5">
                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-lg text-sm font-black text-white"
                    style={`background-color: ${step.accentDark};`}
                  >
                    {step.id}
                  </span>
                  <h3 class="mt-4 text-base font-bold text-slate-900">{step.title}</h3>
                  <p class="mt-1 text-xs font-medium text-slate-500">{step.durationHint}</p>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{step.summary}</p>
                  <p class="mt-4 border-t border-slate-200 pt-3 text-xs text-slate-500">
                    Siapkan: {step.requirements.join(' • ')}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Dokumen & persiapan -->
    <section id="dokumen" class="scroll-mt-20 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-[1fr_auto] lg:gap-8 items-center">
          <div class="max-w-2xl">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Dokumen & Persiapan Sebelum Berangkat
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              Menyiapkan berkas sejak awal mempercepat proses pendaftaran dan mengurangi waktu
              antrean di loket.
            </p>
          </div>

          <DocumentIllustration class="h-24 w-24 sm:h-32 sm:w-32" />

          <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
            {
              QUEUE_DOCUMENTS.map((doc) => (
                <li class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div class="flex items-start gap-3">
                    <span
                      class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-50 text-sm font-bold text-sky-600"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <div>
                      <h3 class="text-sm font-bold text-slate-900">{doc.title}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-slate-600">{doc.description}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 rounded-2xl border border-sky-200 bg-sky-50 p-5 sm:p-6">
            <p class="text-sm leading-relaxed text-sky-900">
              <strong class="font-semibold">Tips:</strong> datang 30 menit sebelum jam pelayanan
              dimulai, pastikan nomor antrean sudah diambil sebelum skrining, dan simpan semua bukti
              sampai obat diterima.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>© {new Date().getFullYear()} {SITE_INFO.hospitalName} — Panduan Alur Pelayanan Rumah Sakit.</p>
      <p class="sm:mb-0">
        <span class="font-medium text-sky-600">{SITE_INFO.serviceHours}</span>
        <span class="ml-2 text-slate-500">|</span>
        <a
          href={SITE_INFO.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline text-sky-600 hover:underline-offset-4"
        >
          {SITE_INFO.officialUrl === '#' ? 'Layanan Online' : SITE_INFO.officialUrl}
        </a>
      </p>
      <p class="sm:mb-0 text-slate-500">
        {SITE_INFO.disclaimer}
      </p>
    </div>
  </footer>
</Layout>