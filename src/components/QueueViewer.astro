---
import { QUEUE_STEPS } from '../data/queueSteps';

const first = QUEUE_STEPS[0];
---

<section id="simulasi" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-12 sm:px-6 lg:px-8">
  <div class="mb-8">
    <div>
      <span
        class="inline-flex items-center rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700 ring-1 ring-sky-600/20 ring-inset"
      >
        Simulasi 3D Isometrik
      </span>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Alur Antrean Pelayanan Rumah Sakit
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">
        Pilih tahapan untuk melihat pergerakan pasien antar ruangan serta informasi layanan yang
        perlu disiapkan.
      </p>
    </div>

  </div>

  <!-- Scene 3D full-width; stepper menjadi layer melayang di atasnya -->
  <div class="scene-stage">
    <div id="scene-container" class="h-[420px] w-full sm:h-[500px] lg:h-[560px]"></div>

    <!-- Stepper Navigasi (layer di atas kanvas) -->
    <div class="scene-overlay">
      <div
        class="scene-overlay-panel"
        role="tablist"
        aria-label="Tahapan antrean"
        id="step-tablist"
      >
        {
          QUEUE_STEPS.map((step, idx) => (
            <button
              type="button"
              role="tab"
              id={`step-tab-${idx}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls="step-detail-card"
              tabindex={idx === 0 ? '0' : '-1'}
              data-selected={idx === 0 ? 'true' : null}
              data-step-index={idx}
              class="step-tab min-h-10 cursor-pointer rounded-lg border border-transparent bg-white/70 px-3 py-2.5 text-left text-xs font-medium text-slate-600 transition hover:border-slate-300 hover:bg-white hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 sm:px-3.5 sm:text-sm data-[selected=true]:border-sky-600 data-[selected=true]:bg-sky-600 data-[selected=true]:text-white data-[selected=true]:hover:border-sky-600 data-[selected=true]:hover:bg-sky-700 data-[selected=true]:hover:text-white"
            >
              {step.shortLabel}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <p class="mt-4 text-xs text-slate-500">
    Gunakan scroll untuk memperbesar atau memperkecil tampilan. Kamera otomatis mengikuti pasien
    saat berjalan lalu mendekat saat pasien tiba dan berbincang dengan petugas.
  </p>
  <p class="mt-2 text-xs text-slate-500">
    Nomor antrean dan estimasi waktu pada simulasi ini bersifat ilustrasi dan tidak mewakili data antrean
    secara real-time.
  </p>

  <!-- Kontrol animasi 3D -->
  <div class="mt-6 flex gap-2">
    <button
      id="replay-btn"
      type="button"
      class="rounded-xl bg-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-300 disabled:opacity-40"
      aria-label="Ulangi animasi tahap"
    >
      Ulangi
    </button>
    <button
      id="pause-btn"
      type="button"
      class="rounded-xl bg-emerald-100 px-3 py-1.5 text-sm font-medium text-emerald-800 transition hover:bg-emerald-300 disabled:opacity-40"
      aria-label="Jeda/lanjut animasi"
    >
      <span id="pause-icon-pause" class="hidden">❚❚</span>
      <span id="pause-icon-play">▶︎</span>
    </button>
  </div>

  <p id="anim-status" class="mt-2 text-xs text-slate-500">
    Sedang berjalan
  </p>

  <!-- Kartu Informasi: dua kolom di bawah kanvas -->
  <div
    id="step-detail-card"
    role="tabpanel"
    aria-labelledby="step-tab-0"
    aria-live="polite"
    class="mt-6 grid grid-cols-1 gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-2 min-h-[520px]"
  >
    <div>
      <div class="flex items-center justify-between gap-2">
        <span
          id="step-badge"
          class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-semibold text-white"
          style={`background-color: ${first.accentDark};`}
        >
          Tahap {first.id} dari {QUEUE_STEPS.length}
        </span>
        <span id="step-duration" class="text-xs font-medium text-slate-500">
          {first.durationHint}
        </span>
      </div>

      <h3 id="step-title" class="mt-4 text-xl font-bold text-slate-900">{first.title}</h3>
      <p id="step-summary" class="mt-2 text-sm leading-relaxed text-slate-600">
        {first.summary}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <button
          id="prev-step-btn"
          type="button"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:pointer-events-none disabled:opacity-40"
        >
          Sebelumnya
        </button>
        <button
          id="next-step-btn"
          type="button"
          class="rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 disabled:pointer-events-none disabled:opacity-40"
        >
          Tahap Berikutnya
        </button>
      </div>
    </div>

    <div class="border-t border-slate-100 pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-6">
      <h4 class="text-xs font-semibold tracking-wider text-slate-500 uppercase">
        Hal yang Perlu Disiapkan
      </h4>
      <ul id="step-requirements" class="mt-3 space-y-2 text-sm text-slate-700">
        {
          first.requirements.map((req) => {
            // Warna latar ikon berdasarkan tipe persyaratan
            const isKTP = req.includes('Kartu Identitas');
            const isBPJS = req.includes('BPJS');
            const isRujukan = req.includes('Rujukan');
            const isRekam = req.includes('Rekam Medis');
            const isKeluhan = req.includes('Keluhan');
            const isPembayaran = req.includes('Pembayaran');

            // Warna latar ikon menggunakan style inline
            const iconStyle = isKTP ? { backgroundColor: 'rgba(112, 128, 144, 1)' } :
                       isBPJS ? { backgroundColor: 'rgba(39, 174, 96, 1)' } :
                       isRujukan ? { backgroundColor: 'rgba(255, 165, 0, 1)' } :
                       isRekam ? { backgroundColor: 'rgba(139, 92, 246, 1)' } :
                       isKeluhan ? { backgroundColor: 'rgba(255, 193, 7, 1)' } :
                       isPembayaran ? { backgroundColor: 'rgba(34, 139, 34, 1)' } :
                       { backgroundColor: 'rgba(112, 128, 144, 1)' };

            return (
              <li>
                {/* Ikon warna berdasarkan tipe persyaratan */}
                <div style={{ ...iconStyle, width: 24, height: 24 }}>
                  <svg width={16} height={16} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3 20 -3 20h-6v-5H7v5H5v-5H2v5h5v5h2v-5h5v2h5v-5h2v5h5l2-10h-5z" />
                  </svg>
                </div>
                <span>{req}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { HospitalQueueScene } from './HospitalQueueScene';
  import { QUEUE_STEPS } from '../data/queueSteps';

  const container = document.getElementById('scene-container');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.step-tab'));
  const tablist = document.getElementById('step-tablist');
  const prevBtn = document.getElementById('prev-step-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-step-btn') as HTMLButtonElement | null;
  const card = document.getElementById('step-detail-card');

  const badgeEl = document.getElementById('step-badge');
  const durationEl = document.getElementById('step-duration');
  const titleEl = document.getElementById('step-title');
  const summaryEl = document.getElementById('step-summary');
  const reqListEl = document.getElementById('step-requirements');

  let activeIndex = 0;
  let sceneInstance: HospitalQueueScene | null = null;

  function renderInfoCard(index: number) {
    const step = QUEUE_STEPS[index];
    if (!step) return;

    if (badgeEl) {
      badgeEl.textContent = `Tahap ${step.id} dari ${QUEUE_STEPS.length}`;
      badgeEl.style.backgroundColor = step.accentDark;
    }
    if (durationEl) durationEl.textContent = step.durationHint;
    if (titleEl) titleEl.textContent = step.title;
    if (summaryEl) summaryEl.textContent = step.summary;

    if (card) card.setAttribute('aria-labelledby', `step-tab-${index}`);

    if (reqListEl) {
      reqListEl.innerHTML = step.requirements
        .map(
          (item) => `
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style="background-color: ${step.accentColor}"></span>
            <span>${item}</span>
          </li>
        `
        )
        .join('');
    }

    tabs.forEach((tab, idx) => {
      const selected = idx === index;
      if (selected) tab.setAttribute('data-selected', 'true');
      else tab.removeAttribute('data-selected');
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.tabIndex = selected ? 0 : -1;
      // Latar tab aktif mengikuti aksen tahap (varian gelap agar kontras).
      if (selected) {
        tab.style.backgroundColor = step.accentDark;
        tab.style.borderColor = step.accentDark;
        tab.style.color = '#ffffff';
      } else {
        tab.style.backgroundColor = '';
        tab.style.borderColor = '';
        tab.style.color = '';
      }
    });
  }

  function updateNavState() {
    if (prevBtn) prevBtn.disabled = activeIndex === 0;
    if (nextBtn) nextBtn.disabled = activeIndex === QUEUE_STEPS.length - 1;
  }

  function goToStep(index: number) {
    activeIndex = Math.max(0, Math.min(index, QUEUE_STEPS.length - 1));
    renderInfoCard(activeIndex);
    sceneInstance?.setStep(activeIndex, false);
    updateNavState();
  }

  let animPaused = false;

  if (container) {
    sceneInstance = new HospitalQueueScene(container);
    // Samakan state tab awal dengan aksen tahap pertama.
    renderInfoCard(0);

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        goToStep(Number(tab.dataset.stepIndex ?? 0));
      });
    });

    tablist?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      let next: number | null = null;
      if (key === 'ArrowRight' || key === 'ArrowDown') next = activeIndex + 1;
      else if (key === 'ArrowLeft' || key === 'ArrowUp') next = activeIndex - 1;
      else if (key === 'Home') next = 0;
      else if (key === 'End') next = QUEUE_STEPS.length - 1;
      if (next === null) return;
      event.preventDefault();
      goToStep(next);
      tabs[activeIndex]?.focus();
    });

    prevBtn?.addEventListener('click', () => goToStep(activeIndex - 1));
    nextBtn?.addEventListener('click', () => goToStep(activeIndex + 1));

    // --- Kontrol animasi baru ---
    const replayBtn = document.getElementById('replay-btn') as HTMLButtonElement | null;
    const pauseBtn = document.getElementById('pause-btn') as HTMLButtonElement | null;
    const pauseIconPause = document.getElementById('pause-icon-pause') as HTMLSpanElement | null;
    const pauseIconPlay = document.getElementById('pause-icon-play') as HTMLSpanElement | null;
    const animStatus = document.getElementById('anim-status') as HTMLParagraphElement | null;

    replayBtn?.addEventListener('click', () => {
      sceneInstance?.replay();
      animPaused = false;
      updatePauseButton();
      if (animStatus) animStatus.textContent = 'Sedang berjalan';
    });

    pauseBtn?.addEventListener('click', () => {
      animPaused = !animPaused;
      sceneInstance?.setPaused(animPaused);
      updatePauseButton();
      if (animStatus) animStatus.textContent = animPaused ? 'Dijeda' : 'Sedang berjalan';
    });

    // --- end kontrol animasi ---

    updateNavState();

    // --- Keyboard controls: Space bar toggle pause/replay ---
    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === ' ') {
        event.preventDefault();
        if (animPaused) {
          sceneInstance?.replay();
          animPaused = false;
          updatePauseButton();
          if (animStatus) animStatus.textContent = 'Sedang berjalan';
        } else {
          sceneInstance?.setPaused(true);
          animPaused = true;
          updatePauseButton();
          if (animStatus) animStatus.textContent = 'Dijeda';
        }
      }
    });

    window.addEventListener('beforeunload', () => {
      sceneInstance?.dispose();
      sceneInstance = null;
    });
  }
</script>
